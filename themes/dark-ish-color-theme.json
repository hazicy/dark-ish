  "tokenColors": [
    {
      "name": "Embedded code",
      "scope": [
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#D6DAE0",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#858E98",
        "fontStyle": ""
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring.multi.python",
        "string.quoted.docstring.raw.multi.python",
        "string.quoted.docstring.single.python",
        "string.quoted.docstring.raw.single.python"
      ],
      "settings": {
        "foreground": "#99A2AC",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#DE91B1",
        "fontStyle": ""
      }
    },
    {
      "name": "Boolean constants",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#E0A368"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
